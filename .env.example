# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3001
# Generate a secure secret with: npm run generate-secret
NEXTAUTH_SECRET=your-secret-key-here-minimum-32-characters-long

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/nomnoms"

# Environment
NODE_ENV=development

# Optional: OAuth Providers
# Google OAuth (get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (get from https://github.com/settings/developers)
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# Optional: Security Settings
RATE_LIMIT_ENABLED=true
LOG_LEVEL=debug

# Brave Search API key
# Optional: recipe web search on /discover (key from https://api-dashboard.search.brave.com/).
# Without it, Discover's search box opens a normal web search in a new tab; pasting a URL
# and the clipper still work.
BRAVE_SEARCH_API_KEY=
